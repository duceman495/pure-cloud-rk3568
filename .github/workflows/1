name: Photonicat Ultimate Cloud Build

on:
  workflow_dispatch: # 允许手动点击触发

jobs:
  build:
    runs-on: ubuntu-22.04 # 使用 22.04 资源池，排队最快

    steps:
    - name: 1. 终极释放磁盘空间 (强行腾出40GB空间，彻底告别爆盘)
      uses: jlumbroso/free-disk-space@main
      with:
        tool-cache: true
        android: true
        dotnet: true
        haskell: true
        large-packages: true
        docker-images: true
        swap-storage: true

    - name: 2. 安装光影猫官方指定的全部环境依赖 (已修复 Python 冲突)
      env:
        DEBIAN_FRONTEND: noninteractive
      run: |
        sudo apt-get update
        sudo apt-get install -y build-essential flex bison genext2fs \
          ccache ecj fastjar file g++ gawk gettext git \
          java-propose-classpath libelf-dev libncurses5-dev \
          libncursesw5-dev libssl-dev python2.7-dev python3 \
          unzip wget python3-distutils python3-setuptools python3-dev \
          rsync subversion swig time xsltproc zlib1g-dev \
          device-tree-compiler gcc-aarch64-linux-gnu bc lz4 python-is-python3 python2

    - name: 3. 从零拉取光影猫 RK3568 源码 SDK
      run: |
        git clone https://github.com/photonicat/rockchip_rk3568_linux_sdk -b openwrt --single-branch rk3568-linux-sdk
        cd rk3568-linux-sdk
        git submodule update --init

    - name: 4. 执行官方配置与【终极防翻车补丁】
      run: |
        cd rk3568-linux-sdk
        ./rk3568-config-photonicat-openwrt.sh
        
        # 强制注入补丁：干掉 ath11k 固件的哈希校验
        sed -i 's/4a2d09661d8ae932f93b1cdf9889197f4051bc0dfe9b757fddc6f4af566f0bb3/skip/g' openwrt/package/firmware/ath11k-firmware/Makefile || true
        
        # 【盲肠切除术】：暴力干掉 igmpproxy 和 wpad-basic，防止编译崩溃
        sed -i '/CONFIG_PACKAGE_igmpproxy/d' openwrt/.config || true
        echo "# CONFIG_PACKAGE_igmpproxy is not set" >> openwrt/.config
        sed -i '/CONFIG_PACKAGE_wpad-basic/d' openwrt/.config || true
        echo "# CONFIG_PACKAGE_wpad-basic is not set" >> openwrt/.config

    - name: 5. 启动核爆级云端循环编译 (强行碾压错误)
      run: |
        cd rk3568-linux-sdk
        export CROSS_COMPILE=aarch64-linux-gnu-
        
        echo "=== 第一阶段：全速多线程冲刺 ==="
        ./build.sh || true
        
        echo "=== 第二阶段：单线程排雷碾压模式 ==="
        cd openwrt
        for i in 1 2 3; do
          if make -j1 V=s IGNORE_ERRORS=1; then
            echo "OpenWrt 编译成功！"
            break
          else
            echo "第 $i 次遇到错误，强行打上标记跳过并继续..."
          fi
        done
        
        echo "=== 第三阶段：最终打包固件 ==="
        cd ..
        ./build.sh || true

    - name: 6. 收集并上传最终刷机镜像包
      uses: actions/upload-artifact@v4
      with:
        name: Photonicat-Custom-Image
        path: rk3568-linux-sdk/rockdev/pack/*.img
